# Mock credentials for local development.
# Copy to .env (untracked) and fill in real values — NEVER commit real tokens.
# SSO JWTs expire 8 hours after minting; refresh your .env the same day.

# Raw SSO JWT from the FinX handoff (sent as-is, no "Bearer" prefix)
FINX_SSO_JWT=paste-sso-jwt-here

# Session token from the FinX handoff (X-Session-Id header / upstream `from` header)
FINX_SESSION=paste-session-token-here

# Decrypted test client code (X-User-Id header / upstream InvCode)
FINX_TEST_CLIENT_ID=X0xxxxx

# Optional backend overrides (defaults shown; see backend/README.md)
# UPSTREAM_PROFILE_URL=https://mf.choiceindia.com/api/v2/investor/profile/extended
# UPSTREAM_TIMEOUT_SECONDS=10

# KB query-embedding timeout (CHO-285) — per attempt, separate from the FinX
# budget above. embed_query makes at most two attempts, so this caps the stall
# before a KB search degrades to FTS-only at roughly 2x this value.
# KB_EMBED_TIMEOUT_SECONDS=3

# Agent tracing (CHO-261) — self-hosted observability of the agent loop.
# Each /api/chat turn is captured as an execution graph and stored in our OWN
# Postgres (agent_traces table) — no external service, no egress, no cost.
# ON by default; persistence needs the DB pool (DATABASE_URL) at request time.
# AGENT_TRACING=1                    # 0/false/off to disable tracing
# TRACING_SALT=jini-tracing          # HMAC salt pseudonymising thread/user ids

# Langfuse trace mirror (CHO-286) — a SECOND sink for the same span tree.
# Postgres `agent_traces` stays the system of record; Langfuse is a mirror, so
# losing it loses a UI, not data. Self-hosted only: set the base URL to your own
# instance. Default OFF; needs the flag AND both keys AND the URL to activate.
# The two keys are SECRETS — real values belong only in the untracked .env.
# LANGFUSE_TRACING=0                 # 1/true/yes/on to mirror spans to Langfuse
# LANGFUSE_PUBLIC_KEY=pk-lf-xxxxxxxx # from the Langfuse project settings
# LANGFUSE_SECRET_KEY=sk-lf-xxxxxxxx # from the Langfuse project settings
# LANGFUSE_BASE_URL=http://localhost:3000

# Trace viewer dashboard (CHO-262) — the admin-gated /traces UI over the traces.
# UNSET ⇒ every /api/traces* endpoint returns 404 (dashboard fully off). Set it
# to a long random secret to enable; the UI sends it as the X-Traces-Token header.
# TRACES_ADMIN_TOKEN=paste-a-long-random-admin-token-here

# Trace cost display (CHO-275) — INR per 1 USD for estimated spend on /traces.
# Default 96.46; estimate only (tokens × Anthropic list rates), not live billing.
# TRACE_COST_USD_TO_INR=96.46

# Prompt playground (CHO-272) — editable AskFinX prompts at /playground.html.
# UNSET ⇒ every /api/playground* endpoint returns 404 (playground fully off).
# Set a long random secret; the UI sends it as the X-Playground-Token header.
# PLAYGROUND_TOKEN=paste-a-long-random-playground-token-here

# Agent model (CHO-270) — defaults to Sonnet 4.6 with thinking off (smallest).
# AGENT_MODEL=claude-sonnet-4-6      # or claude-haiku-4-5
# AGENT_THINKING=off                 # or minimal

# History prompt caching (CHO-264) — rolling cache_control breakpoint on the
# conversation tip, so replayed history bills as cache reads instead of fresh
# input. ON by default; gates only the marker, never the message layout.
# AGENT_HISTORY_CACHE=1              # 0/false/off = no-rebuild rollback

# Model-facing context curation (CHO-271) — spent tool_result payloads are
# replaced by authored stubs before the request is sent, so the model stops
# abstaining over its own history. Read-time projection only: the conversation
# store, ticket transcripts and replay keep every byte. OFF by default; flipped
# on per environment after the CHO-276 routing evals pass (the default itself
# flips in a later commit). How many turns stay verbatim is NOT configurable.
# AGENT_CONTEXT_CURATION=0           # 1/true/yes/on to curate model context
