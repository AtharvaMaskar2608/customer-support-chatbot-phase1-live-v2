# Langfuse prod stack env — template. Copy to `.env` NEXT TO the compose file
# on the server and fill every value. The compose file uses `${VAR:?...}` for
# each secret, so a missing or blank one is a hard startup failure rather than
# a silent fallback to upstream's public defaults (`mysalt`, `miniosecret`, …).
#
# Do not hand-invent these. Run ./gen-secrets.sh to emit a filled .env with
# cryptographically random values, then edit the two human fields at the end.
#
# This file is a TEMPLATE and is committed. The real `.env` is gitignored and
# lives only on the server — same rule as the Jini `.env`.

# --- Infrastructure credentials (internal to this stack) --------------------
# Only ever used container-to-container on the compose network; none of these
# are reachable from outside the box. Random values, never reused elsewhere.
POSTGRES_PASSWORD=
CLICKHOUSE_PASSWORD=
REDIS_AUTH=
MINIO_ROOT_PASSWORD=

# --- Langfuse application secrets -------------------------------------------
# SALT hashes API keys; ENCRYPTION_KEY encrypts secrets at rest; NEXTAUTH_SECRET
# signs session cookies. CHANGING ANY OF THESE AFTER FIRST BOOT invalidates
# what it protects — rotate deliberately, not casually.
#   SALT            = openssl rand -base64 32
#   ENCRYPTION_KEY  = openssl rand -hex 32   (must be exactly 64 hex chars)
#   NEXTAUTH_SECRET = openssl rand -base64 32
SALT=
ENCRYPTION_KEY=
NEXTAUTH_SECRET=

# Where the UI is reached FROM YOUR BROWSER. The stack binds to loopback on the
# server, so this stays localhost:3000 and you reach it through an SSH tunnel:
#   ssh -L 3000:127.0.0.1:3000 harsh@10.132.147.130
NEXTAUTH_URL=http://localhost:3000

# --- First-boot bootstrap ----------------------------------------------------
# Read ONCE, on the first boot against an empty database, then ignored forever.
# Creates the org, the project, the login user, and the API key pair — so the
# keys exist before anyone opens the UI.
#
# The two keys below are what jini-backend authenticates with: copy them into
# /home/harsh/jini/.env as LANGFUSE_PUBLIC_KEY / LANGFUSE_SECRET_KEY.
# Conventional shape is pk-lf-<uuid> / sk-lf-<uuid>; gen-secrets.sh emits that.
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=
LANGFUSE_INIT_PROJECT_SECRET_KEY=

# Login for the trace UI. The password is a real credential — the UI it unlocks
# shows raw client codes and full conversation text (CHO-287). Signup is
# disabled in the compose file, so this is the only account until you invite
# more from inside the UI.
LANGFUSE_INIT_USER_EMAIL=
LANGFUSE_INIT_USER_PASSWORD=
LANGFUSE_INIT_USER_NAME=Jini Admin

# Cosmetic — org/project labels in the UI. Safe to leave as-is.
LANGFUSE_INIT_ORG_ID=choice
LANGFUSE_INIT_ORG_NAME=Choice
LANGFUSE_INIT_PROJECT_ID=jini
LANGFUSE_INIT_PROJECT_NAME=Choice Jini
